# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# CocoaPods only recognises "Debug" and "Release" by name; every other
# configuration defaults to :release. That is not cosmetic -- React Native
# compiles out the dev server for release configurations, so a staging build
# would launch and immediately die with "No script URL provided".
project 'TemplateProject.xcodeproj',
        'Debug' => :debug,
        'Release' => :release,
        'Debug.Staging' => :debug,
        'Release.Staging' => :release

# react-native-permissions compiles only the handlers listed here. A
# permission that is abstracted in src/services/permissions but missing from
# this list returns "unavailable" at runtime with no other symptom.
#
# Keep this list and the Info.plist usage descriptions in step, and delete
# both for anything the app does not actually use: App Review rejects
# permissions declared without a product reason (AGENTS.md 35).
permissions_path = File.join(__dir__, '..', 'node_modules', 'react-native-permissions', 'scripts')
require File.join(permissions_path, 'setup')

setup_permissions([
  'Camera',
  'LocationWhenInUse',
  'Microphone',
  'Notifications',
  'PhotoLibrary',
])

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# react-native-config maps each Xcode configuration to a .env file. A
# configuration missing from this hash silently falls back to `.env`, which is
# how a staging build ends up pointing at development (brief section 37).
ENVFILES = {
  'Debug'           => '$(PODS_ROOT)/../../.env.development',
  'Release'         => '$(PODS_ROOT)/../../.env.production',
  'Debug.Staging'   => '$(PODS_ROOT)/../../.env.staging',
  'Release.Staging' => '$(PODS_ROOT)/../../.env.staging',
}

target 'TemplateProject' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Some pods -- and in particular the resource-bundle targets CocoaPods
    # generates for them -- ship a deployment target far below what the
    # current Xcode accepts. SDWebImage, pulled in by FastImage, declares 9.0
    # against a supported floor of 15.0, which fails the build outright.
    #
    # Raising every pod target to the React Native minimum keeps this in step
    # with the app target instead of pinning a number that rots (AGENTS.md 35).
    # Point each configuration at its environment file.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        envfile = ENVFILES[config.name]
        config.build_settings['ENVFILE'] = envfile if envfile
      end
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        deployment_target = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']

        if deployment_target.nil? ||
           Gem::Version.new(deployment_target) < Gem::Version.new(min_ios_version_supported)
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
        end
      end
    end
  end
end
