{
  "name": "TemplateProject",
  "version": "0.0.1",
  "template": {
    "version": "1.0.0",
    "reactNative": "0.87.1"
  },
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios --scheme \"TemplateProject Dev\" --mode Debug",
    "start": "watchman watch-del-all && react-native start --reset-cache",
    "android:dev": "react-native run-android --mode developmentDebug",
    "android:staging": "react-native run-android --mode stagingDebug",
    "android:prod": "react-native run-android --mode productionDebug",
    "android:apk:dev": "cd android && ./gradlew assembleDevelopmentRelease",
    "android:apk:staging": "cd android && ./gradlew assembleStagingRelease",
    "android:apk:prod": "cd android && ./gradlew assembleProductionRelease",
    "android:bundle:prod": "cd android && ./gradlew bundleProductionRelease",
    "android:clean": "cd android && ./gradlew clean",
    "ios:dev": "react-native run-ios --scheme \"TemplateProject Dev\" --mode Debug",
    "ios:staging": "react-native run-ios --scheme \"TemplateProject Staging\" --mode Debug.Staging",
    "ios:prod": "react-native run-ios --scheme \"TemplateProject Production\" --mode Release",
    "ios:clean": "cd ios && xcodebuild clean -workspace TemplateProject.xcworkspace -scheme \"TemplateProject Dev\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run typecheck && npm run lint && npm run test",
    "pods": "cd ios && bundle exec pod install && cd ..",
    "prepare": "husky",
    "assets": "node scripts/generate-assets.js",
    "assets:check": "node scripts/generate-assets.js --check",
    "fonts": "node scripts/link-fonts.js",
    "fonts:check": "node scripts/link-fonts.js --check",
    "theme:add-color": "node scripts/add-color.js",
    "theme:check": "node scripts/add-color.js --check",
    "rename": "node scripts/rename.js"
  },
  "dependencies": {
    "@d11/react-native-fast-image": "8.13.0",
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "7.19.2",
    "@react-navigation/native": "7.4.1",
    "@react-navigation/native-stack": "7.19.2",
    "@tanstack/react-query": "5.103.2",
    "axios": "1.20.0",
    "i18next": "26.4.2",
    "react": "19.2.3",
    "react-i18next": "17.0.15",
    "react-native": "0.87.1",
    "react-native-config": "1.7.2",
    "react-native-gesture-handler": "3.3.0",
    "react-native-keychain": "10.0.0",
    "react-native-permissions": "5.6.2",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "5.10.0",
    "react-native-screens": "4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.12.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "react-native-svg-transformer": "1.5.3",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
