{
  "name": "TemplateProject",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android-clean": "cd android && ./gradlew clean && cd ..",
    "android-release": "cd android && ./gradlew assembleRelease && cd ..",
    "ios": "react-native run-ios",
    "ios-clean": "cd ios && rm -rf Pods build Podfile.lock && bundle exec pod install && cd ..",
    "lint": "eslint .",
    "generate-icons": "node scripts/generate-icons.js",
    "generate-icons:check": "node scripts/generate-icons.js --check",
    "start": "watchman watch-del-all && react-native start --reset-cache",
    "deep-clean": "rm -rf node_modules package-lock.json && watchman watch-del-all && rm -rf ios/build && rm -rf android/build android/app/build android/app/.cxx && npm i",
    "test": "jest",
    "pods": "cd ios && bundle exec pod install && cd ..",
    "bundle-release": "cd android && ./gradlew bundleRelease && cd ..",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.87.1",
    "@react-native/new-app-screen": "0.87.1",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
