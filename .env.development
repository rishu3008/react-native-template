# Development environment.
#
# Build configuration only. Nothing here is secret: values are compiled into
# the binary and are extractable from a shipped app (AGENTS.md 23).
ENVIRONMENT=development
API_BASE_URL=https://jsonplaceholder.typicode.com
API_TIMEOUT_MS=15000
API_MAX_RETRIES=2
USE_MOCK_AUTH=true
ENABLE_DEV_TOOLS=true
